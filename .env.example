APP_PORT=8080
ADMINER_PORT=8082
ADMINER_BIND=127.0.0.1
ADMINER_PUBLIC_URL=http://127.0.0.1:8082

POSTGRES_DB=lshop_ozon
POSTGRES_USER=lshop
POSTGRES_PASSWORD=change_this_database_password

JWT_ISSUER=LShopOzonWebReact
JWT_AUDIENCE=LShopOzonWebReact.Client
JWT_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars

# Ozon Seller API for LShop РФ (analytics, products, orders).
# Must be the Russian seller account: https://api-seller.ozon.ru
# Values saved in the app UI (Integrations) override these env vars in the database.
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_CLIENT_ID=put_ozon_client_id_here
OZON_API_KEY=put_ozon_api_key_here

TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here

HTTPS_USE_REDIRECTION=false

BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
